{
  "name": "job-search-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:setup": "npm run db:deploy && prisma db seed",
    "formd:scan": "tsx scripts/formd-scan.ts",
    "db:import": "tsx scripts/import-sqlite.ts",
    "db:local": "prisma dev --detach --name job-search-tool",
    "db:deploy": "prisma migrate deploy && PRISMA_SCHEMA=demo prisma migrate deploy",
    "vercel-build": "npm run db:deploy && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
