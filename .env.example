# Postgres connection string (must start with postgres://).
# Local development: run `npm run db:local` and use the URL below.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Required by SEC EDGAR's fair-access policy: "<your name> <contact email>"
SEC_USER_AGENT="Your Name you@example.com"

# Hosted site only. Leave APP_PASSWORD unset locally to skip sign-in.
# APP_PASSWORD: the password for "Owner sign in". Use a long, unique one.
# CRON_SECRET: any long random string; Vercel sends it with the daily scan.
# APP_PASSWORD=
# CRON_SECRET=

# Optional: enables Crunchbase funding lookups.
# CRUNCHBASE_API_KEY=
